<<Table BAI for GDD Wildchrokie, results='asis', echo = FALSE>>=
options(digits = 2)
a_df2_BAI      <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_a_BAI.csv")
sigma_df2_BAI  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_sigma_BAI.csv")
bspp_df2_BAI   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_bspp_BAI.csv")
treeid_df2_BAI <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_treeid_BAI.csv")
aspp_df2_BAI   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_aspp_BAI.csv")
site_df2_BAI   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_site_BAI.csv")
ayear_df2_BAI  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_ayear_BAI.csv")

bspp_df2_BAI$spp_name <- emp$latbi[match(bspp_df2_BAI$spp, emp$spp_num)]
site_df2_BAI$site_name <- emp$site[match(site_df2_BAI$site, emp$site_num)]
aspp_df2_BAI$spp_name <- emp$latbi[match(aspp_df2_BAI$spp, emp$spp_num)]
ayear_df2_BAI$year_name <- emp$year[match(ayear_df2_BAI$year, emp$year_num)]

alpha <- data.frame(
  Parameter = c("$\\alpha$"),
  Mean   = sprintf("%.2f", a_df2_BAI$mean),
  P5     = sprintf("%.2f", a_df2_BAI$p5),
  P25    = sprintf("%.2f", a_df2_BAI$p25),
  P75    = sprintf("%.2f", a_df2_BAI$p75),
  P95    = sprintf("%.2f", a_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", a_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", a_df2_BAI$n_eff),
  check.names = FALSE
)
sigma <- data.frame(
  Parameter = c("$\\sigma_{\\alpha_{treeid}}$",
                "$\\sigma_{\\alpha_{prov}}$",
                "$\\sigma_{y}$"),
  Mean = sprintf("%.2f", sigma_df2_BAI$mean),
  P5   = sprintf("%.2f", sigma_df2_BAI$p5),
  P25  = sprintf("%.2f", sigma_df2_BAI$p25),
  P75  = sprintf("%.2f", sigma_df2_BAI$p75),
  P95  = sprintf("%.2f", sigma_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", sigma_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", sigma_df2_BAI$n_eff),
  check.names = FALSE
)
bspp <- data.frame(
  Parameter = paste0("$\\beta_{species_{", bspp_df2_BAI$spp_name, "}}$"),
  Mean = sprintf("%.2f", bspp_df2_BAI$mean),
  P5   = sprintf("%.2f", bspp_df2_BAI$p5),
  P25  = sprintf("%.2f", bspp_df2_BAI$p25),
  P75  = sprintf("%.2f", bspp_df2_BAI$p75),
  P95  = sprintf("%.2f", bspp_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", bspp_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", bspp_df2_BAI$n_eff),
  check.names = FALSE
)
aspp <- data.frame(
  Parameter = paste0("$\\alpha_{species_{", aspp_df2_BAI$spp_name, "}}$"),
  Mean = sprintf("%.2f", aspp_df2_BAI$mean),
  P5   = sprintf("%.2f", aspp_df2_BAI$p5),
  P25  = sprintf("%.2f", aspp_df2_BAI$p25),
  P75  = sprintf("%.2f", aspp_df2_BAI$p75),
  P95  = sprintf("%.2f", aspp_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", aspp_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", aspp_df2_BAI$n_eff),
  check.names = FALSE
)
site <- data.frame(
  Parameter = paste0("$\\alpha_{site_{", site_df2_BAI$site_name, "}}$"),
  Mean = sprintf("%.2f", site_df2_BAI$mean),
  P5   = sprintf("%.2f", site_df2_BAI$p5),
  P25  = sprintf("%.2f", site_df2_BAI$p25),
  P75  = sprintf("%.2f", site_df2_BAI$p75),
  P95  = sprintf("%.2f", site_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", site_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", site_df2_BAI$n_eff),
  check.names = FALSE
)
ayear <- data.frame(
  Parameter = paste0("$\\alpha_{year_{", ayear_df2_BAI$year_name, "}}$"),
  Mean = sprintf("%.2f", ayear_df2_BAI$mean),
  P5   = sprintf("%.2f", ayear_df2_BAI$p5),
  P25  = sprintf("%.2f", ayear_df2_BAI$p25),
  P75  = sprintf("%.2f", ayear_df2_BAI$p75),
  P95  = sprintf("%.2f", ayear_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", ayear_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", ayear_df2_BAI$n_eff),
  check.names = FALSE
)
binded <- rbind(alpha, sigma, bspp, site, ayear, aspp)

print(xtable(binded,
             caption = "Summary output of each parameter from our GDD (growing degree days) model, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\\% and 50\\% uncertainty intervals. See `Data analyses' in Methods section for more details.",
             label = "tab:BAItab"),
      include.rownames = FALSE,
      sanitize.text.function = identity,
      sanitize.colnames.function = function(x) paste0(gsub("P5$", "5\\\\%", gsub("P95", "95\\\\%", gsub("P25", "25\\\\%", gsub("P75", "75\\\\%", x))))),
      caption.placement = "top")

@

<<Table BAI for GSL Wildchrokie, results='asis', echo = FALSE>>=
options(digits = 2)
a_df2_BAI      <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GSLparam_a_BAI.csv")
sigma_df2_BAI  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GSLparam_sigma_BAI.csv")
bspp_df2_BAI   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GSLparam_bspp_BAI.csv")
treeid_df2_BAI <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GSLparam_treeid_BAI.csv")
aspp_df2_BAI   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GSLparam_aspp_BAI.csv")
site_df2_BAI   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GSLparam_site_BAI.csv")
ayear_df2_BAI  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GSLparam_ayear_BAI.csv")

bspp_df2_BAI$spp_name <- emp$latbi[match(bspp_df2_BAI$spp, emp$spp_num)]
site_df2_BAI$site_name <- emp$site[match(site_df2_BAI$site, emp$site_num)]
aspp_df2_BAI$spp_name <- emp$latbi[match(aspp_df2_BAI$spp, emp$spp_num)]
ayear_df2_BAI$year_name <- emp$year[match(ayear_df2_BAI$year, emp$year_num)]

alpha <- data.frame(
  Parameter = c("$\\alpha$"),
  Mean = sprintf("%.2f", a_df2_BAI$mean),
  P5   = sprintf("%.2f", a_df2_BAI$p5),
  P25  = sprintf("%.2f", a_df2_BAI$p25),
  P75  = sprintf("%.2f", a_df2_BAI$p75),
  P95  = sprintf("%.2f", a_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", a_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", a_df2_BAI$n_eff),
  check.names = FALSE
)
sigma <- data.frame(
  Parameter = c("$\\sigma_{\\alpha_{treeid}}$",
                "$\\sigma_{\\alpha_{prov}}$",
                "$\\sigma_{y}$"),
  Mean = sprintf("%.2f", sigma_df2_BAI$mean),
  P5   = sprintf("%.2f", sigma_df2_BAI$p5),
  P25  = sprintf("%.2f", sigma_df2_BAI$p25),
  P75  = sprintf("%.2f", sigma_df2_BAI$p75),
  P95  = sprintf("%.2f", sigma_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", sigma_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", sigma_df2_BAI$n_eff),
  check.names = FALSE
)
bspp <- data.frame(
  Parameter = paste0("$\\beta_{species_{", bspp_df2_BAI$spp_name, "}}$"),
  Mean = sprintf("%.2f", bspp_df2_BAI$mean),
  P5   = sprintf("%.2f", bspp_df2_BAI$p5),
  P25  = sprintf("%.2f", bspp_df2_BAI$p25),
  P75  = sprintf("%.2f", bspp_df2_BAI$p75),
  P95  = sprintf("%.2f", bspp_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", bspp_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", bspp_df2_BAI$n_eff),
  check.names = FALSE
)
aspp <- data.frame(
  Parameter = paste0("$\\alpha_{species_{", aspp_df2_BAI$spp_name, "}}$"),
  Mean = sprintf("%.2f", aspp_df2_BAI$mean),
  P5   = sprintf("%.2f", aspp_df2_BAI$p5),
  P25  = sprintf("%.2f", aspp_df2_BAI$p25),
  P75  = sprintf("%.2f", aspp_df2_BAI$p75),
  P95  = sprintf("%.2f", aspp_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", aspp_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", aspp_df2_BAI$n_eff),
  check.names = FALSE
)
site <- data.frame(
  Parameter = paste0("$\\alpha_{site_{", site_df2_BAI$site_name, "}}$"),
  Mean = sprintf("%.2f", site_df2_BAI$mean),
  P5   = sprintf("%.2f", site_df2_BAI$p5),
  P25  = sprintf("%.2f", site_df2_BAI$p25),
  P75  = sprintf("%.2f", site_df2_BAI$p75),
  P95  = sprintf("%.2f", site_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", site_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", site_df2_BAI$n_eff),
  check.names = FALSE
)
ayear <- data.frame(
  Parameter = paste0("$\\alpha_{year_{", ayear_df2_BAI$year_name, "}}$"),
  Mean = sprintf("%.2f", ayear_df2_BAI$mean),
  P5   = sprintf("%.2f", ayear_df2_BAI$p5),
  P25  = sprintf("%.2f", ayear_df2_BAI$p25),
  P75  = sprintf("%.2f", ayear_df2_BAI$p75),
  P95  = sprintf("%.2f", ayear_df2_BAI$p95),
  `\\^R` = sprintf("%.2f", ayear_df2_BAI$Rhat),
  `ESS`  = sprintf("%.0f", ayear_df2_BAI$n_eff),
  check.names = FALSE
)
binded <- rbind(alpha, sigma, bspp, site, ayear, aspp)

print(xtable(binded,
             caption = "Summary output of each parameter from our GSL (growing season length) model, using basal area increment (log($mm^2$)) as the response variable. We report estimates as mean and 90\\% and 50\\% uncertainty intervals. See `Data analyses' in Methods section for more details.",
             label = "tab:BAItab_gsl"),
      include.rownames = FALSE,
      sanitize.text.function = identity,
      sanitize.colnames.function = function(x) paste0(gsub("P5$", "5\\\\%", gsub("P95", "95\\\\%", gsub("P25", "25\\\\%", gsub("P75", "75\\\\%", x))))),
      caption.placement = "top")
@

<<Table param EOS Wildchrokie, results='asis', echo = FALSE>>=
a_df_EOS      <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_a.csv")
sigma_df_EOS  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_sigma.csv")
bspp_df_EOS   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_bspp.csv")
aspp_df_EOS   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_aspp.csv")
site_df_EOS   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_site.csv")
ayear_df_EOS  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_ayear.csv")

bspp_df_EOS$spp_name   <- emp$latbi[match(bspp_df_EOS$spp, emp$spp_num)]
site_df_EOS$site_name  <- emp$site[match(site_df_EOS$site, emp$site_num)]
aspp_df_EOS$spp_name   <- emp$latbi[match(aspp_df_EOS$spp, emp$spp_num)]
ayear_df_EOS$year_name <- emp$year[match(ayear_df_EOS$year, emp$year_num)]

param_labels_EOS <- c(
  "$\\alpha$",
  "$\\sigma_{\\alpha_{treeid}}$", "$\\sigma_{\\alpha_{prov}}$", "$\\sigma_{y}$",
  paste0("$\\beta_{species_{",   bspp_df_EOS$spp_name,  "}}$"),
  paste0("$\\alpha_{prov_{", site_df_EOS$site_name, "}}$"),
  paste0("$\\alpha_{year_{", ayear_df_EOS$year_name, "}}$"),
  paste0("$\\alpha_{species_{",  aspp_df_EOS$spp_name,  "}}$")
)

combined_EOS <- data.frame(
  "Parameter" = param_labels_EOS,
  rbind(
    fmt_split(a_df_EOS), fmt_split(sigma_df_EOS), fmt_split(bspp_df_EOS),
    fmt_split(site_df_EOS), fmt_split(ayear_df_EOS), fmt_split(aspp_df_EOS)
  ),
  check.names = FALSE
)

colnames(combined_EOS) <- c("Parameter", "Mean", "5\\%", "25\\%", "75\\%", "95\\%",
                            "\\^R", "ESS")
tab_EOS <- xtable(combined_EOS,
              caption = "Summary output of each parameter for the end of season (EOS) predictor of ring width (log(mm)). We report estimates as mean and 90\\% and 50\\% uncertainty intervals. See `Data analyses' in Methods section for more details.",
              label = "tab:tab_EOS")

print(tab_EOS,
      include.rownames = FALSE,
      sanitize.text.function = identity,
      caption.placement = "top",
      hline.after = c(-1, 0, nrow(combined_EOS)),
      floating = TRUE
)
@



