<<Setup, echo=FALSE, message=FALSE, warning=FALSE>>=
library(xtable)
source("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/rcode/GSfigure.R")
source("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/rcode/growthModelsMain_plots.R")
source("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/rcode/climate_plots.R")

samples <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/nSamplesCookieCore.csv")
climna <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/input/_notcookies/climateNA.csv")
climna$site_name <- c("Harvard Forest (MA, USA)", "White Mountains (NH, USA)", "Second College Grant (NH, USA)", "St-Hippolyte (Qc, Canada)", "Arnold Arboretum (MA, USA)")

options(digits = 2)

locations <- data.frame(
  name       = c("Harvard Forest (MA, USA)", "White Mountains (NH, USA)", "Second College Grant (NH, USA)", "St-Hippolyte (Qc, Canada)", "Arnold Arboretum (MA, USA)"),
  Longitude  = c(-72.20,  -71.00, -71.15, -74.01, -71.13),
  Latitude   = c(42.55,  44.49,  44.79,  45.98, 42.296)
)
locations$Altitude <- climna$Altitude_taken[match(locations$name,  climna$site_name)]

locations$MAT <- climna$MAT[match(locations$name, climna$site_name)]
locations$MSP <- climna$MSP[match(locations$name, climna$site_name)]
locations$FFP <- climna$FFP[match(locations$name, climna$site_name)]

count <- aggregate(treeid ~ latbi + site, emp, 
                   FUN = function(x) length(unique(x)))

species <- unique(count$latbi)

count_wide <- reshape(count, idvar = "site", timevar = "latbi", direction = "wide")

locations <- locations[order(locations$Latitude),]

locations2 <- merge(locations[2:5,], count_wide, by.x = "name", by.y = "site", all.x = TRUE)
colnames(locations2) <- c("Provenance name", 
                          "Longitude", "Latitude", "Altitude",
                         "MAT", "MSP", "FFP",
                         "A. incana",
                         "B. alleghaniensis",
                         "B. papyrifera",
                         "B. populifolia")

colnames(locations)[1] <- "Provenance name"

# Species in italics
wctablespp <- c("A. incana" = "\\textit{A. incana}", 
                "B. alleghaniensis" = "\\textit{B. alleghaniensis}",
                "B. papyrifera" = "\\textit{B. papyrifera}",
                "B. populifolia" = "\\textit{B. populifolia}")


# change NAs to 0
for (i in 4: ncol(locations2)) {
  locations2[[i]][is.na(locations2[[i]])] <- 0
}

# Helper function to report results more efficiently:
fmt_stat <- function(df, spp) {
  row <- df[df$spp_name == spp, ]
  if (nrow(row) != 1) {
    stop("Expected exactly 1 row for '", spp, "', got ", nrow(row))
  }
  sprintf("%.2f\\%% (UI: %.2f, %.2f)", row$mean, row$p5, row$p95)
}

mean_rw_mm <- aggregate(lengthMM ~ spp_num, data = emp, FUN = mean)
names(mean_rw_mm)[2] <- "mean_rw_mm"

# read csvs in per
b_gdd_per <- read.csv("output/GM_GDDparam_bspp_per.csv")
b_gsl_per <- read.csv("output/GM_GSLparam_bspp_per.csv")
b_sos_per <- read.csv("output/GM_SOSparam_bspp_per.csv")
b_eos_per <- read.csv("output/GM_EOSparam_bspp_per.csv")

# growth gain by extending y days in spring vs autumn
b_sosgain <- read.csv("output/GM_GDD_sosgain.csv")
b_eosgain <- read.csv("output/GM_GDD_eosgain.csv")
# average across species
b_sosgain_mu <- read.csv("output/GM_GDD_sosgain_mu.csv")
b_eosgain_mu <- read.csv("output/GM_GDD_eosgain_mu.csv")
b_sosgain_mu$spp_name <- "all"
b_eosgain_mu$spp_name <- "all"
@

