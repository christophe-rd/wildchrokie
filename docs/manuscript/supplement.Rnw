<<Table count per spp per prov, results='asis', echo = FALSE>>=
loctable <- data.frame(
  Provenance = locations2$`Provenance name`,
  Ainc       = locations2$`A. incana`,
  Ball       = locations2$`B. alleghaniensis`,
  Bpap       = locations2$`B. papyrifera`,
  Bpop       = locations2$`B. populifolia`
)

n_ainc <- sum(loctable$Ainc)
n_ball <- sum(loctable$Ball)
n_bpap <- sum(loctable$Bpap)
n_bpop <- sum(loctable$Bpop)

header <- list(
  pos = list(-1),
  command = paste0(
    "\\hline\n",
    "Provenance & ",
    "\\textit{A. incana} & ",
    "\\textit{B. alleghaniensis} & ",
    "\\textit{B. papyrifera} & ",
    "\\textit{B. populifolia} \\\\\n",
    " & ",
    "$(n = ", n_ainc, ")$ & ",
    "$(n = ", n_ball, ")$ & ",
    "$(n = ", n_bpap, ")$ & ",
    "$(n = ", n_bpop, ")$ \\\\\n",
    "\\hline\n"
  )
)

tab_species <- xtable(loctable,
              digits = c(0, 0, 0, 0, 0, 0),
              caption = "Number of individuals sampled per species and per provenance for a total of 81 individual trees sampled from the United States of America (in Massachusetts (MA) and New Hampshire (NH)) and Canada (in Quebec (Qc)).",
              label = "tab:tab_species"
)

print(tab_species,
      add.to.row = header,
      include.rownames = FALSE,
      include.colnames = FALSE,
      caption.placement = "top",
      sanitize.text.function = identity)
@

<<Table prov climate, results='asis', echo = FALSE>>=

t2019 <- wcjja$tmeanmean[wcjja$year == 2019]
t2020 <- wcjja$tmeanmean[wcjja$year == 2020]
t2018 <- wcjja$tmeanmean[wcjja$year == 2018]

climtable <- data.frame(
  Provenance = locations$`Provenance name`,
  Latitude   = locations$Latitude,
  Longitude  = locations$Longitude,
  Altitude   = locations$Altitude,
  MAT        = locations$MAT,
  MSP        = locations$MSP,
  FFP        = locations$FFP
)

# Than
caption_text <- sprintf(
  "Provenance and common garden location (Arnold Arboretum) coordinates and 1951--1980 climate normals: mean annual temperature (MAT; \\degree C), mean summer precipitation (MSP; mm), and frost-free period (FFP; days). We extracted these climate variables at each provenance from \\citep{wang_locally_2016}. At the common garden location, the mean summer temperature was similar across years, with 2019 being the coolest (%.1f\\degree C), 2020 the hottest (%.1f\\degree C), and 2018 in between (%.1f\\degree C). There was no drought for those three years, except in 2020, when a moderate summer drought (June--August) ramped up to a severe drought in September \\citep{nationalcentersforenvironmentalinformationncei_north_2026}.",
  t2019, t2020, t2018
)


tab_climate <- xtable(
  climtable,
  digits = c(0,0,1,1,1,1,0,0),
  caption = caption_text,
  label = "tab:climate"
)

print(tab_climate,
      include.rownames = FALSE,
      caption.placement = "top")
@ 

% Phenology observations time series
\begin{figure}[!ht]
\includegraphics[width=0.6\textwidth]{/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/figures/empiricalData/phenoTimeseries.pdf}
\caption{Leaf phenology monitoring frequency across years. We monitored leaf phenology once or twice per week for three years, though the frequency varied within and across years. Each histogram bin represents the number of observations that were made during a period of 14 days and the solid lines represent the earliest (in green), the average (in black) and last (in orange) recorded budburst observations; the dashed lines depict the budset observations. This demonstrates that across the different frequencies of observation, distances between early spring phenophases were similar across years.}
\label{fig:phenoTimeSeries}
\end{figure}

% Rw per year for allometry
\begin{figure}[!ht]
\includegraphics[width=1\textwidth]{/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/figures/empiricalData/rwXyearAll.pdf}
\caption{We show the potential allometry patterns across all years we had ring width for. For this, we randomly sampled 20 trees from our dataset and represent their ring width (mm) for each year.}
\label{fig:allom}
\end{figure}

<<Table param GDD Wildchrokie, results='asis', echo = FALSE>>=
options(digits = 2)

a_df_GDD      <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_a.csv")
sigma_df_GDD  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_sigma.csv")
bspp_df_GDD   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_bspp.csv")
aspp_df_GDD   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_aspp.csv")
site_df_GDD   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_site.csv")
ayear_df_GDD  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_GDDparam_ayear.csv")

bspp_df_GDD$spp_name   <- emp$latbi[match(bspp_df_GDD$spp, emp$spp_num)]
site_df_GDD$site_name  <- emp$site[match(site_df_GDD$site, emp$site_num)]
aspp_df_GDD$spp_name   <- emp$latbi[match(aspp_df_GDD$spp, emp$spp_num)]
ayear_df_GDD$year_name <- emp$year[match(ayear_df_GDD$year, emp$year_num)]

param_labels_GDD <- c(
  "$\\alpha$",
  "$\\sigma_{\\alpha_{treeid}}$", "$\\sigma_{\\alpha_{prov}}$", "$\\sigma_{y}$",
  paste0("$\\beta_{species_{",   bspp_df_GDD$spp_name,  "}}$"),
  paste0("$\\alpha_{prov_{", site_df_GDD$site_name, "}}$"),
  paste0("$\\alpha_{year_{", ayear_df_GDD$year_name, "}}$"),
  paste0("$\\alpha_{species_{",  aspp_df_GDD$spp_name,  "}}$")
)

fmt_split <- function(df) {
  data.frame(
    Mean = sprintf("%.2f", df$mean),
    `5\\%` = sprintf("%.2f", df$p5),
    `25\\%` = sprintf("%.2f", df$p25),
    `75\\%` = sprintf("%.2f", df$p75),
    `95\\%` = sprintf("%.2f", df$p95),
    `\\^R` = sprintf("%.2f", df$Rhat),
    `ESS` = sprintf("%.0f", df$n_eff),
    check.names = FALSE
  )
}

combined_GDD <- data.frame(
  "Parameter" = param_labels_GDD,
  rbind(
    fmt_split(a_df_GDD), fmt_split(sigma_df_GDD), fmt_split(bspp_df_GDD),
    fmt_split(site_df_GDD), fmt_split(ayear_df_GDD), fmt_split(aspp_df_GDD)
  ),
  check.names = FALSE
)

colnames(combined_GDD) <- c("Parameter", "Mean", "5\\%", "25\\%", "75\\%", "95\\%",
                            "\\^R", "ESS")

tab_GDD <- xtable(combined_GDD,
              caption = "Summary output of each parameter for the growing degree days (GDD) predictor of ring width (log(mm)). We report estimates as mean, 90\\% and 50\\% uncertainty intervals. See `Data analyses' in Methods section for more details. ",
              label = "tab:tab_GDD")

print(tab_GDD,
      include.rownames = FALSE,
      sanitize.text.function = identity,
      caption.placement = "top",
      hline.after = c(-1, 0, nrow(combined_GDD)),
      floating = TRUE
)
@


