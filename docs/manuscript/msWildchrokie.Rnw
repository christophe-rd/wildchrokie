<<Table param EOS Wildchrokie, results='asis', echo = FALSE>>=
a_df_EOS      <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_a.csv")
sigma_df_EOS  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_sigma.csv")
bspp_df_EOS   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_bspp.csv")
aspp_df_EOS   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_aspp.csv")
site_df_EOS   <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_site.csv")
ayear_df_EOS  <- read.csv("/Users/christophe_rouleau-desrochers/github/wildchrokie/analyses/output/GM_EOSparam_ayear.csv")

bspp_df_EOS$spp_name   <- emp$latbi[match(bspp_df_EOS$spp, emp$spp_num)]
site_df_EOS$site_name  <- emp$site[match(site_df_EOS$site, emp$site_num)]
aspp_df_EOS$spp_name   <- emp$latbi[match(aspp_df_EOS$spp, emp$spp_num)]
ayear_df_EOS$year_name <- emp$year[match(ayear_df_EOS$year, emp$year_num)]

param_labels_EOS <- c(
  "$\\alpha$",
  "$\\sigma_{\\alpha_{treeid}}$", "$\\sigma_{\\alpha_{prov}}$", "$\\sigma_{y}$",
  paste0("$\\beta_{species_{",   bspp_df_EOS$spp_name,  "}}$"),
  paste0("$\\alpha_{prov_{", site_df_EOS$site_name, "}}$"),
  paste0("$\\alpha_{year_{", ayear_df_EOS$year_name, "}}$"),
  paste0("$\\alpha_{species_{",  aspp_df_EOS$spp_name,  "}}$")
)

combined_EOS <- data.frame(
  "Parameter" = param_labels_EOS,
  rbind(
    fmt_split(a_df_EOS), fmt_split(sigma_df_EOS), fmt_split(bspp_df_EOS),
    fmt_split(site_df_EOS), fmt_split(ayear_df_EOS), fmt_split(aspp_df_EOS)
  ),
  check.names = FALSE
)

colnames(combined_EOS) <- c("Parameter", "Mean", "5\\%", "25\\%", "75\\%", "95\\%",
                            "\\^R", "ESS")
tab_EOS <- xtable(combined_EOS,
              caption = "Summary output of each parameter for the end of season (EOS) predictor of ring width (log(mm)). We report estimates as mean and 90\\% and 50\\% uncertainty intervals. See `Data analyses' in Methods section for more details.",
              label = "tab:tab_EOS")

print(tab_EOS,
      include.rownames = FALSE,
      sanitize.text.function = identity,
      caption.placement = "top",
      hline.after = c(-1, 0, nrow(combined_EOS)),
      floating = TRUE
)
@



