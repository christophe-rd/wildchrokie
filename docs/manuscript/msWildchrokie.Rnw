t2019 <- wcjja$tmeanmean[wcjja$year == 2019]
t2020 <- wcjja$tmeanmean[wcjja$year == 2020]
t2018 <- wcjja$tmeanmean[wcjja$year == 2018]

climtable <- data.frame(
  Provenance = locations$`Provenance name`,
  Latitude   = locations$Latitude,
  Longitude  = locations$Longitude,
